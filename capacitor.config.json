{
  "appId": "com.mizanlar.crm",
  "appName": "Mizan",
  "webDir": "www",
  "server": {
    "url": "https://crm.mizan.co",
    "cleartext": false,
    "allowNavigation": [
      "crm.mizan.co",
      "crm.mizanlar.com"
    ],
    "errorPath": "hata.html"
  },
  "appendUserAgent": "MizanApp/1",
  "backgroundColor": "#0f172a",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorShareTarget": {
      "appGroupId": "group.com.mizanlar.crm"
    }
  }
}
